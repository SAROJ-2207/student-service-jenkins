pipeline{
    agent {
        label 'microservice'
    }
     stages{
        stage('git-checkout'){
            steps{
               git branch: 'main', url: 'https://github.com/SAROJ-2207/student-service.git'
            }
        }
     stage('mvn-build'){
            steps{
              sh 'mvn clean package'
            }
        }
    stage('upload-to-nexus'){
            steps{
              sh '''
                    cat <<EOF > custom-settings.xml
            <settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
             <servers>
                <server>
                      <id>student-service-nexus</id>
                      <username>admin</username>
                      <password>Admin@123456</password>
                </server>
              </servers>
            </settings>
            EOF
                    mvn clean deploy -s custom-settings.xml
                    rm -f custom-settings.xml
                '''
            }
        }
    stage('Checkout Dockerfile') {
        steps {
            dir('docker-repo'){
                git branch: 'main', url: 'https://github.com/SAROJ-2207/student-service.git'
                            }
                    }
            }
       stage('Docker build') {
        steps {
              sh 'echo "success"'            
              sh 'docker build -t student-svc:${BUILD_NUMBER} .'
              
               }
            }

    }
}
